# Copy to .env and fill in. .env is git-ignored.
# Alpaca -> Paper account -> API Keys (Trading API, not Broker API)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must stay true until you deliberately go live
ALPACA_PAPER=true
# Optional: size trades as if the account held only this much (USD). Per strategy: ALPACA_SWING_US_STOCKS_CAPITAL etc.
# ALPACA_CAPITAL=10000
# Optional: where the SQLite trade log lives (default: data/trades.db)
# TRADE_DB=data/trades.db

# Optional: a separate paper account per strategy (recommended). Falls back to the default above.
# ALPACA_TREND_SPY_API_KEY=
# ALPACA_TREND_SPY_SECRET_KEY=
# ALPACA_SWING_US_STOCKS_API_KEY=
# ALPACA_SWING_US_STOCKS_SECRET_KEY=
